[Unit]
Description=AAU Confessions Chat API
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/aau-confessions
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 chat/chat_api.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
